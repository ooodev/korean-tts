# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Data: 24 kHz Parquet shards (1.8 GB) and the shard parts used for parallel prepare
data/
data_fast/
data_smoke/
data_smoke100/
data_parts/

# Acoustic features (5.5 GB of .pt files)
features/
features2/
features_fast/
features_smoke/
features_smoke100/
features_w/

# Alignments: the full run is committed (32 MB, the exact trainer input); the
# smoke/probe rounds are regenerable
annotations/
annotations_fast/
annotations_fast2/
annotations_smoke/
annotations_smoke100/

# Model checkpoints: the 83 MB resume checkpoints are excluded, the 17 MB
# inference graph is not
runs/*
!runs/full/
runs/full/*
!runs/full/inference.pt
!runs/full/config.json
!runs/full/recipe.json
!runs/full/metrics.jsonl

# dizione's dictionaries (5 MB, needed by the front end); the aligner and
# Whisper checkpoints are downloaded on first use
weights/*
!weights/phonemizer/

# Stage logs: the full training log is committed, the per-stage ones are noise
logs_*.txt
!logs_train_full.txt

# Evaluation audio: the full run and the step-80 000 pre-check
eval/*
!eval/full/
eval/full/*
!eval/full/audio/
!eval/full/report.json
!eval/precheck/
