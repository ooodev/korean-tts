{"id": "6ac20e8db37d149e_M2", "speaker": "M2", "text": "\"What is the matter?\" I asked.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8521, "weak_phone_fraction": 0.0, "max_phone_frames": 19, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.2, "pause_frames": 35, "leading_frames": 24, "trailing_frames": 2, "vowel_voiced": 0.3134, "voiceless_voiced": 0.0714, "pause_voiced": 0.0571, "pause_level_db": -80.1, "speech_level_db": -9.8, "silence_threshold_db": -54.8}}
{"id": "986e9ba668bc2934_M2", "speaker": "M2", "text": "We're out of toothpaste again.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8066, "weak_phone_fraction": 0.0556, "max_phone_frames": 11, "one_frame_phone_fraction": 0.0, "phones_per_second": 14.18, "pause_frames": 24, "leading_frames": 19, "trailing_frames": 5, "vowel_voiced": 0.4286, "voiceless_voiced": 0.1579, "pause_voiced": 0.0, "pause_level_db": -83.1, "speech_level_db": -11.2, "silence_threshold_db": -56.7}}
{"id": "339c28f77132b3d4_M2", "speaker": "M2", "text": "\"Where's Harold?\" I asked presently.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.86, "weak_phone_fraction": 0.0, "max_phone_frames": 16, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.97, "pause_frames": 89, "leading_frames": 66, "trailing_frames": 4, "vowel_voiced": 0.1899, "voiceless_voiced": 0.1765, "pause_voiced": 0.0, "pause_level_db": -76.7, "speech_level_db": -11.2, "silence_threshold_db": -57.3}}
{"id": "77c88db7dadaf8b1_M2", "speaker": "M2", "text": "No, I'm a journalist, objected Falk.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8092, "weak_phone_fraction": 0.0435, "max_phone_frames": 43, "one_frame_phone_fraction": 0.0, "phones_per_second": 10.32, "pause_frames": 46, "leading_frames": 34, "trailing_frames": 1, "vowel_voiced": 0.4808, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -82.8, "speech_level_db": -12.2, "silence_threshold_db": -57.3}}
{"id": "6348ebbf9b94e6ae_M2", "speaker": "M2", "text": "Huh, interesting, I would never have thought of that.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7779, "weak_phone_fraction": 0.1, "max_phone_frames": 25, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.9, "pause_frames": 105, "leading_frames": 50, "trailing_frames": 3, "vowel_voiced": 0.4824, "voiceless_voiced": 0.25, "pause_voiced": 0.0, "pause_level_db": -72.1, "speech_level_db": -10.5, "silence_threshold_db": -56.1}}
{"id": "9a0ad10b5486a35b_M2", "speaker": "M2", "text": "Let's just drop it, okay? It's not worth the trouble.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8116, "weak_phone_fraction": 0.0, "max_phone_frames": 20, "one_frame_phone_fraction": 0.0, "phones_per_second": 14.52, "pause_frames": 57, "leading_frames": 27, "trailing_frames": 3, "vowel_voiced": 0.4891, "voiceless_voiced": 0.2683, "pause_voiced": 0.0, "pause_level_db": -73.4, "speech_level_db": -10.4, "silence_threshold_db": -55.6}}
{"id": "e159be01f612e184_F2", "speaker": "F2", "text": "You are tired, you know.", "reasons": ["weak_alignment"], "qc": {"token_probability_mean": 0.5811, "weak_phone_fraction": 0.3, "max_phone_frames": 36, "one_frame_phone_fraction": 0.0, "phones_per_second": 7.27, "pause_frames": 36, "leading_frames": 34, "trailing_frames": 2, "vowel_voiced": 0.9765, "voiceless_voiced": 0.0769, "pause_voiced": 0.0, "pause_level_db": -63.6, "speech_level_db": -9.9, "silence_threshold_db": -55.1}}
{"id": "e159be01f612e184_M2", "speaker": "M2", "text": "You are tired, you know.", "reasons": ["weak_alignment"], "qc": {"token_probability_mean": 0.5977, "weak_phone_fraction": 0.3, "max_phone_frames": 30, "one_frame_phone_fraction": 0.0, "phones_per_second": 9.77, "pause_frames": 39, "leading_frames": 36, "trailing_frames": 3, "vowel_voiced": 0.8305, "voiceless_voiced": 0.5556, "pause_voiced": 0.0769, "pause_level_db": -86.5, "speech_level_db": -11.3, "silence_threshold_db": -56.7}}
{"id": "fb9803a396cc3fd9_M2", "speaker": "M2", "text": "I wish I could be there.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7852, "weak_phone_fraction": 0.0833, "max_phone_frames": 23, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.6, "pause_frames": 31, "leading_frames": 28, "trailing_frames": 3, "vowel_voiced": 0.3929, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -82.7, "speech_level_db": -12.8, "silence_threshold_db": -58.2}}
{"id": "2e655b61ddb3bc6f_M2", "speaker": "M2", "text": "Most bitterly did she cry.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8845, "weak_phone_fraction": 0.0, "max_phone_frames": 28, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.98, "pause_frames": 35, "leading_frames": 22, "trailing_frames": 5, "vowel_voiced": 0.4923, "voiceless_voiced": 0.1538, "pause_voiced": 0.0, "pause_level_db": -78.8, "speech_level_db": -10.9, "silence_threshold_db": -56.6}}
{"id": "d77784e66794caaa_F2", "speaker": "F2", "text": "Won't you catch it though!", "reasons": ["low_confidence"], "qc": {"token_probability_mean": 0.4741, "weak_phone_fraction": 0.2308, "max_phone_frames": 27, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.95, "pause_frames": 18, "leading_frames": 14, "trailing_frames": 4, "vowel_voiced": 0.9434, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -67.2, "speech_level_db": -9.2, "silence_threshold_db": -54.3}}
{"id": "275ffb7b4bba4004_M2", "speaker": "M2", "text": "But that is not success, Joyce.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7898, "weak_phone_fraction": 0.1, "max_phone_frames": 17, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.5, "pause_frames": 23, "leading_frames": 21, "trailing_frames": 2, "vowel_voiced": 0.434, "voiceless_voiced": 0.0541, "pause_voiced": 0.0, "pause_level_db": -86.3, "speech_level_db": -12.1, "silence_threshold_db": -57.1}}
{"id": "4613410c924ad488_M2", "speaker": "M2", "text": "I'm sorry, I already have plans.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8109, "weak_phone_fraction": 0.0, "max_phone_frames": 40, "one_frame_phone_fraction": 0.0, "phones_per_second": 10.76, "pause_frames": 27, "leading_frames": 27, "trailing_frames": 0, "vowel_voiced": 0.4556, "voiceless_voiced": 0.1538, "pause_voiced": 0.0, "pause_level_db": -88.0, "speech_level_db": -11.0, "silence_threshold_db": -56.1}}
{"id": "8737e1c599ea02ae_M2", "speaker": "M2", "text": "I know, right? It feels like it just started.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.815, "weak_phone_fraction": 0.037, "max_phone_frames": 32, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.94, "pause_frames": 88, "leading_frames": 21, "trailing_frames": 4, "vowel_voiced": 0.4409, "voiceless_voiced": 0.1429, "pause_voiced": 0.0, "pause_level_db": -75.5, "speech_level_db": -12.3, "silence_threshold_db": -57.9}}
{"id": "b385a691026c6b43_M2", "speaker": "M2", "text": "\"Yes,\" said Sylvia, not much above a whisper.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8666, "weak_phone_fraction": 0.037, "max_phone_frames": 28, "one_frame_phone_fraction": 0.0, "phones_per_second": 10.91, "pause_frames": 61, "leading_frames": 37, "trailing_frames": 1, "vowel_voiced": 0.4941, "voiceless_voiced": 0.0556, "pause_voiced": 0.0, "pause_level_db": -71.4, "speech_level_db": -17.1, "silence_threshold_db": -62.7}}
{"id": "be14f7f9d46a2a85_M2", "speaker": "M2", "text": "Totally. It's been stuck in my head all week.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.862, "weak_phone_fraction": 0.0, "max_phone_frames": 41, "one_frame_phone_fraction": 0.0, "phones_per_second": 12.53, "pause_frames": 8, "leading_frames": 6, "trailing_frames": 2, "vowel_voiced": 0.49, "voiceless_voiced": 0.25, "pause_voiced": 0.0, "pause_level_db": -83.2, "speech_level_db": -10.5, "silence_threshold_db": -55.5}}
{"id": "10ac4b8cb98f0804_F2", "speaker": "F2", "text": "Want to grab coffee this weekend?", "reasons": ["weak_alignment"], "qc": {"token_probability_mean": 0.6755, "weak_phone_fraction": 0.2609, "max_phone_frames": 11, "one_frame_phone_fraction": 0.0, "phones_per_second": 15.51, "pause_frames": 26, "leading_frames": 17, "trailing_frames": 9, "vowel_voiced": 1.0, "voiceless_voiced": 0.3636, "pause_voiced": 0.0385, "pause_level_db": -73.6, "speech_level_db": -10.8, "silence_threshold_db": -56.0}}
{"id": "0535ecf1edea77e5_M2", "speaker": "M2", "text": "I'm free after six, if that works.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.907, "weak_phone_fraction": 0.0, "max_phone_frames": 17, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.59, "pause_frames": 17, "leading_frames": 10, "trailing_frames": 7, "vowel_voiced": 0.2222, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -86.7, "speech_level_db": -13.9, "silence_threshold_db": -59.0}}
{"id": "93b44ff6bec0a52d_M2", "speaker": "M2", "text": "Tell me about it!", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7222, "weak_phone_fraction": 0.0909, "max_phone_frames": 11, "one_frame_phone_fraction": 0.0, "phones_per_second": 16.11, "pause_frames": 11, "leading_frames": 9, "trailing_frames": 2, "vowel_voiced": 0.4583, "voiceless_voiced": 0.1, "pause_voiced": 0.0, "pause_level_db": -81.0, "speech_level_db": -12.1, "silence_threshold_db": -57.3}}
{"id": "c97a3a938f1ff1d0_M2", "speaker": "M2", "text": "Why of course, papa?", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7161, "weak_phone_fraction": 0.0909, "max_phone_frames": 17, "one_frame_phone_fraction": 0.0, "phones_per_second": 9.38, "pause_frames": 33, "leading_frames": 33, "trailing_frames": 0, "vowel_voiced": 0.4151, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -83.8, "speech_level_db": -9.5, "silence_threshold_db": -54.8}}
{"id": "145c8c96e3ac0968_M2", "speaker": "M2", "text": "What's the row about?", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8309, "weak_phone_fraction": 0.0, "max_phone_frames": 15, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.6, "pause_frames": 31, "leading_frames": 25, "trailing_frames": 6, "vowel_voiced": 0.4545, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -83.5, "speech_level_db": -10.7, "silence_threshold_db": -55.8}}
{"id": "3f11f5d692827253_F2", "speaker": "F2", "text": "You'll go, won't you?", "reasons": ["weak_alignment", "low_confidence"], "qc": {"token_probability_mean": 0.4185, "weak_phone_fraction": 0.3636, "max_phone_frames": 20, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.21, "pause_frames": 28, "leading_frames": 20, "trailing_frames": 8, "vowel_voiced": 1.0, "voiceless_voiced": 0.1667, "pause_voiced": 0.1071, "pause_level_db": -71.3, "speech_level_db": -8.3, "silence_threshold_db": -53.6}}
{"id": "f9503f3038ac2ecb_M2", "speaker": "M2", "text": "\"You couldn't, and be truthful, sir,\" declared the girl.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8131, "weak_phone_fraction": 0.0, "max_phone_frames": 30, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.67, "pause_frames": 51, "leading_frames": 19, "trailing_frames": 9, "vowel_voiced": 0.287, "voiceless_voiced": 0.037, "pause_voiced": 0.0, "pause_level_db": -70.4, "speech_level_db": -11.3, "silence_threshold_db": -56.4}}
{"id": "2cdd15d9226b440f_M2", "speaker": "M2", "text": "\"Yes,\" said Porthos; \"I see a man.\"", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.747, "weak_phone_fraction": 0.1111, "max_phone_frames": 32, "one_frame_phone_fraction": 0.0, "phones_per_second": 8.0, "pause_frames": 37, "leading_frames": 7, "trailing_frames": 4, "vowel_voiced": 0.4891, "voiceless_voiced": 0.0, "pause_voiced": 0.1081, "pause_level_db": -69.6, "speech_level_db": -14.3, "silence_threshold_db": -59.8}}
{"id": "f1f4ec9f69aecca6_M2", "speaker": "M2", "text": "\"I registered their deed of gift yesterday.\"", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8927, "weak_phone_fraction": 0.0, "max_phone_frames": 18, "one_frame_phone_fraction": 0.0, "phones_per_second": 14.38, "pause_frames": 27, "leading_frames": 19, "trailing_frames": 8, "vowel_voiced": 0.4744, "voiceless_voiced": 0.0526, "pause_voiced": 0.0, "pause_level_db": -83.9, "speech_level_db": -12.0, "silence_threshold_db": -57.2}}
{"id": "b9b2e29c51ccdd03_M2", "speaker": "M2", "text": "\"What do you want?\" she said stiffly.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.7435, "weak_phone_fraction": 0.1364, "max_phone_frames": 15, "one_frame_phone_fraction": 0.0, "phones_per_second": 13.48, "pause_frames": 65, "leading_frames": 32, "trailing_frames": 4, "vowel_voiced": 0.2545, "voiceless_voiced": 0.025, "pause_voiced": 0.0, "pause_level_db": -83.5, "speech_level_db": -10.2, "silence_threshold_db": -56.0}}
{"id": "da305664528a7208_M2", "speaker": "M2", "text": "Oh, I love that way of looking at it!", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8288, "weak_phone_fraction": 0.0, "max_phone_frames": 51, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.38, "pause_frames": 30, "leading_frames": 28, "trailing_frames": 2, "vowel_voiced": 0.4615, "voiceless_voiced": 0.0, "pause_voiced": 0.0, "pause_level_db": -84.8, "speech_level_db": -11.8, "silence_threshold_db": -56.9}}
{"id": "df2cce1c0f00de32_M2", "speaker": "M2", "text": "\"Of course not,\" said Patsy, quickly.", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8952, "weak_phone_fraction": 0.0, "max_phone_frames": 16, "one_frame_phone_fraction": 0.0, "phones_per_second": 11.46, "pause_frames": 38, "leading_frames": 21, "trailing_frames": 8, "vowel_voiced": 0.3521, "voiceless_voiced": 0.0204, "pause_voiced": 0.0, "pause_level_db": -77.3, "speech_level_db": -13.0, "silence_threshold_db": -58.7}}
{"id": "bbbfa73a9d2dd660_M2", "speaker": "M2", "text": "\"Oh! yes--I understand you perfectly.\"", "reasons": ["vowels_not_voiced"], "qc": {"token_probability_mean": 0.8042, "weak_phone_fraction": 0.0417, "max_phone_frames": 42, "one_frame_phone_fraction": 0.0417, "phones_per_second": 11.42, "pause_frames": 43, "leading_frames": 31, "trailing_frames": 12, "vowel_voiced": 0.3951, "voiceless_voiced": 0.0351, "pause_voiced": 0.0, "pause_level_db": -85.4, "speech_level_db": -13.0, "silence_threshold_db": -58.5}}
